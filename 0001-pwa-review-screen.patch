+      and set the order &mdash; leave it alone and the top 5 by priority go out automatically.</p>
+
+    <div class="field-block">
+      <span class="field-label">Going out (in order)</span>
+      <div id="reviewSelectedList" class="review-list"></div>
+    </div>
+
+    <div class="field-block">
+      <span class="field-label">Not selected</span>
+      <div id="reviewUnselectedList" class="review-list"></div>
+    </div>
+
+    <button class="download-all-btn" id="saveReviewBtn">Save selection</button>
+    <div class="download-status" id="reviewSaveStatus"></div>
+  </div>
+</div>
+
 <div id="exitToast" class="exit-toast" hidden>Press back again to exit</div>
 
